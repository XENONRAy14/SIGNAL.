# Use long alphanumeric secrets (URL-safe PostgreSQL password).
POSTGRES_PASSWORD=replace_with_32_random_alphanumeric_characters
ADMIN_EMAIL=admin@signal.local
ADMIN_PASSWORD=replace_with_a_unique_long_password
APP_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
ENVIRONMENT=production
SEED_DEMO=true
# Optional. CV content is sent to OpenAI only when the user checks the AI option.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Published web port (change APP_ORIGIN accordingly).
WEB_PORT=8080
# Automatic discovery. Verified starter catalog of employers with a public ATS board.
SEED_CATALOG=true
# France Travail "Offres d'emploi v2" (free account on francetravail.io). Empty = source disabled.
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Optional comma-separated departments (e.g. 13,75,69). Empty = all of France.
FT_DEPARTEMENTS=
FT_BACKFILL_HOURS=48
# Adzuna (free key on developer.adzuna.com). Empty = source disabled.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENABLE_ARBEITNOW=true
# Aggregated offers are closed after this many days without being seen again.
AGGREGATOR_TTL_DAYS=30
DISCOVERY_BATCH=40
